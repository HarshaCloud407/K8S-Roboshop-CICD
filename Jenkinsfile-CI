pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        DOCKER_USER   = 'hariprasad123456'
        APP_DIR       = 'roboshop-docker'
        ALL_SERVICES  = 'catalogue user cart shipping payment frontend'

        // Must match names configured in Jenkins (case-sensitive)
        SONAR_SERVER  = 'SonarQube'        // Manage Jenkins > System > SonarQube servers > Name
        SONAR_SCANNER = 'sonar-scanner'    // Manage Jenkins > Tools > SonarQube Scanner > Name
        DOCKER_CREDS  = 'dockerhub-creds'  // Username with password credential ID
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG        = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
                    echo "Image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Detect Changed Services') {
            steps {
                script {
                    // Files changed in the last commit (empty if there is no parent commit)
                    def changed = sh(
                        script: 'git diff --name-only HEAD~1 HEAD 2>/dev/null || true',
                        returnStdout: true
                    ).trim()

                    def all = env.ALL_SERVICES.split(' ') as List
                    def selected = []

                    // First build, Jenkinsfile change, or unknown diff -> build everything
                    if (!changed || changed.contains('Jenkinsfile')) {
                        selected = all
                    } else {
                        all.each { svc ->
                            if (changed.readLines().any { it.startsWith("${env.APP_DIR}/${svc}/") || it.startsWith("${svc}/") }) {
                                selected << svc
                            }
                        }
                    }

                    env.CHANGED_SERVICES = selected.join(' ')
                    echo "Services to build: ${env.CHANGED_SERVICES ?: 'none'}"
                }
            }
        }

        stage('SonarQube Analysis') {
            when { expression { env.CHANGED_SERVICES?.trim() } }
            steps {
                script {
                    def scannerHome = tool env.SONAR_SCANNER
                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                              -Dsonar.projectKey=roboshop \
                              -Dsonar.projectName=roboshop \
                              -Dsonar.sources=${env.APP_DIR} \
                              -Dsonar.exclusions=**/node_modules/**,**/target/**,**/*.min.js \
                              -Dsonar.java.binaries=.
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { expression { env.CHANGED_SERVICES?.trim() } }
            steps {
                // Needs SonarQube webhook: http://<jenkins-url>/sonarqube-webhook/
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            when { expression { env.CHANGED_SERVICES?.trim() } }
            steps {
                sh '''#!/bin/bash
                    set -e
                    for svc in ${CHANGED_SERVICES}; do
                        echo "=== Building ${DOCKER_USER}/${svc}:${IMAGE_TAG} ==="
                        docker build \
                            -t ${DOCKER_USER}/${svc}:${IMAGE_TAG} \
                            -t ${DOCKER_USER}/${svc}:latest \
                            ${APP_DIR}/${svc}
                    done
                '''
            }
        }

        stage('Trivy Image Scan') {
            when { expression { env.CHANGED_SERVICES?.trim() } }
            steps {
                sh '''#!/bin/bash
                    set -e
                    mkdir -p trivy-reports
                    for svc in ${CHANGED_SERVICES}; do
                        echo "=== Trivy scan: ${svc} ==="
                        # Report everything (does not fail)
                        trivy image --no-progress --severity HIGH,CRITICAL --ignore-unfixed \
                            --format table --exit-code 0 \
                            --output trivy-reports/${svc}.txt \
                            ${DOCKER_USER}/${svc}:${IMAGE_TAG}
                        # Fail only on fixable CRITICAL vulnerabilities
                        trivy image --no-progress --severity CRITICAL --ignore-unfixed \
                            --exit-code 1 \
                            ${DOCKER_USER}/${svc}:${IMAGE_TAG}
                    done
                '''
            }
        }

        stage('Docker Push') {
            when { expression { env.CHANGED_SERVICES?.trim() } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKER_CREDS,
                    usernameVariable: 'DH_USER',
                    passwordVariable: 'DH_PASS'
                )]) {
                    sh '''#!/bin/bash
                        set -e
                        echo "${DH_PASS}" | docker login -u "${DH_USER}" --password-stdin
                        for svc in ${CHANGED_SERVICES}; do
                            echo "=== Pushing ${DOCKER_USER}/${svc} ==="
                            docker push ${DOCKER_USER}/${svc}:${IMAGE_TAG}
                            docker push ${DOCKER_USER}/${svc}:latest
                        done
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-reports/*.txt', allowEmptyArchive: true
            sh '''#!/bin/bash
                docker logout || true
                for svc in ${CHANGED_SERVICES}; do
                    docker rmi ${DOCKER_USER}/${svc}:${IMAGE_TAG} || true
                    docker rmi ${DOCKER_USER}/${svc}:latest || true
                done
                docker image prune -f || true
            '''
        }
        success {
            echo "Build ${env.BUILD_NUMBER} SUCCESS. Pushed tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo "Build ${env.BUILD_NUMBER} FAILED, check the failed stage log"
        }
    }
}
